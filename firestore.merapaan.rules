rules_version = '2';

// Dedicated Firestore rules for the MeraPaan application.
// Firebase project: paandukaan-production
// These rules intentionally do not grant access to PartX collections.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSeller() {
      return signedIn()
        && currentUser().roles is list
        && 'seller' in currentUser().roles
        && currentUser().sellerStatus == 'approved';
    }

    function validStageChange() {
      return request.resource.data.stage == resource.data.stage
        || (resource.data.stage == 'Order placed' && request.resource.data.stage in ['Confirmed', 'Rejected'])
        || (resource.data.stage == 'Confirmed' && request.resource.data.stage in ['Preparing', 'Cancelled'])
        || (resource.data.stage == 'Preparing' && request.resource.data.stage in ['Ready for pickup', 'Cancelled'])
        || (resource.data.stage == 'Ready for pickup' && request.resource.data.stage == 'Collected');
    }

    match /users/{uid} {
      allow create: if ownsUser(uid)
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'mobile', 'roles', 'activeRole', 'sellerStatus',
          'storeIds', 'storeName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.roles is list
        && request.resource.data.roles.size() == 1
        && request.resource.data.activeRole in request.resource.data.roles
        && request.resource.data.roles[0] in ['customer', 'seller']
        && (
          request.resource.data.roles[0] == 'customer'
          || request.resource.data.sellerStatus == 'approved'
        );
      allow read: if ownsUser(uid);
      allow update: if ownsUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activeRole', 'name', 'mobile', 'updatedAt'])
        && request.resource.data.activeRole in resource.data.roles;
      allow delete: if false;
    }

    match /paanStores/{storeId} {
      allow read: if true;
      allow create: if isSeller()
        && storeId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSeller()
        && storeId == request.auth.uid
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    match /paanProducts/{productId} {
      allow read: if true;
      allow create: if isSeller()
        && request.resource.data.storeId == request.auth.uid
        && request.resource.data.status in ['published', 'out-of-stock'];
      allow update: if isSeller()
        && resource.data.storeId == request.auth.uid
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.status in ['published', 'out-of-stock', 'draft'];
      allow delete: if isSeller()
        && resource.data.storeId == request.auth.uid;
    }

    match /paanOrders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.storeId is string
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.fulfilment == 'pickup'
        && request.resource.data.pickupDate is string
        && request.resource.data.pickupTime is string
        && request.resource.data.paymentMethod in ['pay-at-shop', 'upi']
        && request.resource.data.paymentStatus in ['PAY_AT_PICKUP', 'PENDING']
        && request.resource.data.stage == 'Order placed';
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || (isSeller() && resource.data.storeId == request.auth.uid)
      );
      allow update: if isSeller()
        && resource.data.storeId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stage', 'paymentStatus', 'paymentReference', 'updatedAt'])
        && validStageChange()
        && request.resource.data.paymentStatus in [
          'PAY_AT_PICKUP', 'PENDING', 'PAID', 'FAILED', 'REFUNDED'
        ];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
